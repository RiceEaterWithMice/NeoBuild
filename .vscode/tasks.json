{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (x64 debug)",
            "type": "process",
            "command": "${env:windir}\\System32\\cmd.exe",
            "args": [
                "/d",
                "/s",
                "/c",
                "${workspaceFolder}\\.vscode\\scripts\\devcmd.cmd",
                "x64",
                "win64-debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "clear": true
            }
        },
        {

{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 23, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "win64-debug",
      "inherits": "windows-base",
      "displayName": "Duke3DX x64 Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "win64-release",
      "inherits": "windows-base",
      "displayName": "Duke3DX x64 Release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "win86-debug",
      "inherits": "windows-base",
      "displayName": "Duke3DX x86 Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "win86-release",
      "inherits": "windows-base",
      "displayName": "Duke3DX x86 Release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "win64-debug", "configurePreset": "win64-debug" },
    { "name": "win64-release", "configurePreset": "win64-release" },
    { "name": "win86-debug", "configurePreset": "win86-debug" },
    { "name": "win86-release", "configurePreset": "win86-release" }
  ]
}
